# Methodology generated artifact
dashboard.html

# Node / VS Code extension build
node_modules/
out/
dist/
*.vsix
.vscode-test/

# Quarto render artifacts (from rendering test fixtures)
test/fixtures/*.html
test/fixtures/*_files/
# `--cache-refresh` (Quarto: Clear Cache command, BACKLOG item 13(d)) creates a
# Jupyter/Knitr execution-cache directory alongside the rendered output.
test/fixtures/*_cache/

# Quarto render artifacts (from rendering the project fixture, incl. its
# nested chapters/ subdirectory and project-level cache)
test/fixtures/project/**/*.html
test/fixtures/project/**/*_files/
test/fixtures/project/.quarto/
# Quarto auto-generates this on first render if none exists (contains only
# `/.quarto/`) — an artifact of rendering, not authored fixture content.
test/fixtures/project/.gitignore

# `quarto inspect`/`quarto render` cache from grounding the yaml-diagnostics
# fixtures against the real CLI (Session 47) — not authored fixture content.
test/fixtures/yaml-diagnostics/**/.quarto/
test/fixtures/yaml-diagnostics/**/.gitignore

# Quarto render artifacts (from rendering docs/*.md locally, e.g. to preview)
docs/*.html
docs/*_files/

# Logs & OS cruft
*.log
.DS_Store
