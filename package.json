{
  "name": "vscode-quarto-ext",
  "displayName": "Quarto (MIT)",
  "description": "MIT-licensed Quarto authoring for VS Code: .qmd highlighting, render, live preview, run code cells, outline, and cross-reference & citation completion.",
  "version": "0.0.1",
  "publisher": "rmsharp",
  "preview": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmsharp/vscode_quarto_ext.git"
  },
  "bugs": {
    "url": "https://github.com/rmsharp/vscode_quarto_ext/issues"
  },
  "homepage": "https://github.com/rmsharp/vscode_quarto_ext#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science"
  ],
  "keywords": [
    "quarto",
    "qmd",
    "rmarkdown",
    "markdown",
    "pandoc",
    "preview",
    "render",
    "notebook",
    "jupyter",
    "citations"
  ],
  "galleryBanner": {
    "color": "#4338CA",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:quarto",
    "onLanguage:yaml",
    "onLanguage:r",
    "workspaceContains:**/*.{qmd,rmd,Rmd}",
    "workspaceContains:**/_quarto.{yml,yaml}"
  ],
  "contributes": {
    "languages": [
      {
        "id": "quarto",
        "aliases": [
          "Quarto",
          "quarto"
        ],
        "extensions": [
          ".qmd",
          ".rmd",
          ".Rmd"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dot",
        "aliases": [
          "Graphviz DOT",
          "dot"
        ],
        "extensions": [
          ".dot",
          ".gv"
        ],
        "configuration": "./languages/dot-language-configuration.json"
      },
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd"
        ],
        "configuration": "./languages/mermaid-language-configuration.json"
      },
      {
        "id": "typst",
        "aliases": [
          "Typst",
          "typst"
        ],
        "extensions": [
          ".typ"
        ],
        "configuration": "./languages/typst-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quarto",
        "scopeName": "text.html.quarto",
        "path": "./syntaxes/quarto.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter": "yaml",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.r": "r",
          "meta.embedded.block.julia": "julia",
          "meta.embedded.block.ojs": "javascript",
          "meta.embedded.block.bash": "shellscript",
          "meta.embedded.block.c": "c",
          "meta.embedded.block.cpp": "cpp",
          "meta.embedded.block.csharp": "csharp",
          "meta.embedded.block.fsharp": "fsharp",
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.go": "go",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.lua": "lua",
          "meta.embedded.block.ruby": "ruby",
          "meta.embedded.block.php": "php",
          "meta.embedded.block.perl": "perl",
          "meta.embedded.block.java": "java",
          "meta.embedded.block.dockerfile": "dockerfile",
          "meta.embedded.block.powershell": "powershell"
        }
      }
    ],
    "commands": [
      {
        "command": "quarto.verifyInstallation",
        "title": "Verify Installation",
        "category": "Quarto"
      },
      {
        "command": "quarto.render",
        "title": "Render",
        "category": "Quarto"
      },
      {
        "command": "quarto.preview",
        "title": "Preview",
        "category": "Quarto"
      },
      {
        "command": "quarto.previewFormat",
        "title": "Preview Format...",
        "category": "Quarto"
      },
      {
        "command": "quarto.previewScript",
        "title": "Preview Script...",
        "category": "Quarto"
      },
      {
        "command": "quarto.renderProject",
        "title": "Render Project",
        "category": "Quarto"
      },
      {
        "command": "quarto.newDocument",
        "title": "New Quarto Document",
        "category": "Quarto"
      },
      {
        "command": "quarto.createProject",
        "title": "Create Project",
        "category": "Quarto"
      },
      {
        "command": "quarto.convertToIpynb",
        "title": "Convert to .ipynb",
        "category": "Quarto"
      },
      {
        "command": "quarto.convertToQmd",
        "title": "Convert to .qmd",
        "category": "Quarto"
      },
      {
        "command": "quarto.runCell",
        "title": "Run Cell",
        "category": "Quarto"
      },
      {
        "command": "quarto.runCellAndAdvance",
        "title": "Run Cell and Advance",
        "category": "Quarto"
      },
      {
        "command": "quarto.runCellsAbove",
        "title": "Run Cells Above",
        "category": "Quarto"
      },
      {
        "command": "quarto.runAllCells",
        "title": "Run All Cells",
        "category": "Quarto"
      },
      {
        "command": "quarto.insertCell",
        "title": "Insert Cell",
        "category": "Quarto"
      },
      {
        "command": "quarto.runSelectedLines",
        "title": "Run Selected Line(s)",
        "category": "Quarto"
      },
      {
        "command": "quarto.runCurrent",
        "title": "Run Current Code",
        "category": "Quarto"
      },
      {
        "command": "quarto.runNextCell",
        "title": "Run Next Cell",
        "category": "Quarto"
      },
      {
        "command": "quarto.runPreviousCell",
        "title": "Run Previous Cell",
        "category": "Quarto"
      },
      {
        "command": "quarto.runCellsBelow",
        "title": "Run Cells Below",
        "category": "Quarto"
      },
      {
        "command": "quarto.toggleBold",
        "title": "Toggle Bold",
        "category": "Quarto"
      },
      {
        "command": "quarto.toggleItalic",
        "title": "Toggle Italic",
        "category": "Quarto"
      },
      {
        "command": "quarto.toggleCode",
        "title": "Toggle Code",
        "category": "Quarto"
      },
      {
        "command": "quarto.previewMath",
        "title": "Preview Math",
        "category": "Quarto"
      },
      {
        "command": "quarto.previewDiagram",
        "title": "Preview Diagram",
        "category": "Quarto"
      },
      {
        "command": "quarto.toggleCodeCellsInOutline",
        "title": "Toggle Code Cells in Outline",
        "category": "Quarto"
      },
      {
        "command": "quarto.formatCell",
        "title": "Format Cell",
        "category": "Quarto"
      },
      {
        "command": "quarto.goToNextCell",
        "title": "Go to Next Cell",
        "category": "Quarto"
      },
      {
        "command": "quarto.goToPreviousCell",
        "title": "Go to Previous Cell",
        "category": "Quarto"
      },
      {
        "command": "quarto.clearCache",
        "title": "Clear Cache...",
        "category": "Quarto"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quarto.convertToIpynb",
          "when": "editorLangId == quarto"
        },
        {
          "command": "quarto.convertToQmd",
          "when": "resourceExtname == .ipynb"
        },
        {
          "command": "quarto.previewFormat",
          "when": "editorLangId == quarto"
        },
        {
          "command": "quarto.previewScript",
          "when": "resourceExtname == .py || resourceExtname == .jl || resourceExtname == .r || resourceExtname == .R"
        }
      ],
      "editor/title": [
        {
          "command": "quarto.clearCache",
          "when": "editorLangId == quarto",
          "group": "quarto"
        },
        {
          "command": "quarto.previewFormat",
          "when": "editorLangId == quarto",
          "group": "quarto"
        },
        {
          "command": "quarto.previewScript",
          "when": "quartoRenderScriptActive",
          "group": "quarto"
        }
      ]
    },
    "keybindings": [
      {
        "command": "quarto.preview",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorLangId == quarto && !quartoRenderScriptActive"
      },
      {
        "command": "quarto.previewScript",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "quartoRenderScriptActive"
      },
      {
        "command": "quarto.runCell",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId == quarto && quarto.inCodeCell"
      },
      {
        "command": "quarto.runCellAndAdvance",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == quarto && quarto.inCodeCell"
      },
      {
        "command": "quarto.runSelectedLines",
        "key": "ctrl+shift+enter",
        "when": "editorTextFocus && editorLangId == quarto && quarto.inCodeCell"
      },
      {
        "command": "quarto.runCurrent",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && editorLangId == quarto && quarto.inCodeCell"
      },
      {
        "command": "quarto.runCellsAbove",
        "key": "ctrl+alt+a",
        "when": "editorTextFocus && editorLangId == quarto"
      },
      {
        "command": "quarto.runCellsBelow",
        "key": "ctrl+alt+b",
        "when": "editorTextFocus && editorLangId == quarto"
      },
      {
        "command": "quarto.runAllCells",
        "key": "ctrl+alt+enter",
        "when": "editorTextFocus && editorLangId == quarto"
      },
      {
        "command": "quarto.runNextCell",
        "key": "ctrl+alt+n",
        "when": "editorTextFocus && editorLangId == quarto"
      },
      {
        "command": "quarto.runPreviousCell",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus && editorLangId == quarto"
      },
      {
        "command": "quarto.insertCell",
        "key": "ctrl+alt+i",
        "when": "editorTextFocus && editorLangId == quarto"
      },
      {
        "command": "quarto.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId == quarto"
      },
      {
        "command": "quarto.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == quarto"
      },
      {
        "command": "quarto.formatCell",
        "key": "ctrl+k ctrl+f",
        "mac": "cmd+k cmd+f",
        "when": "editorTextFocus && editorLangId == quarto && quarto.inCodeCell"
      },
      {
        "command": "quarto.goToNextCell",
        "key": "ctrl+pagedown",
        "mac": "cmd+pagedown",
        "when": "editorTextFocus && editorLangId == quarto"
      },
      {
        "command": "quarto.goToPreviousCell",
        "key": "ctrl+pageup",
        "mac": "cmd+pageup",
        "when": "editorTextFocus && editorLangId == quarto"
      }
    ],
    "snippets": [
      {
        "language": "quarto",
        "path": "./snippets/quarto.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "quarto",
        "scopes": {
          "module": [
            "entity.name.namespace"
          ],
          "*.typeHintComment": [
            "comment.typehint.type.notation.python"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Quarto",
      "properties": {
        "quarto.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `quarto` executable. When empty, the extension resolves `quarto` from the `PATH`."
        },
        "quarto.symbols.showCodeCellsInOutline": {
          "type": "boolean",
          "default": true,
          "description": "Show code cells in the Outline view and editor breadcrumbs."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "quartoGettingStarted",
        "title": "Get Started with Quarto",
        "description": "Install Quarto, write your first document or project, then render, preview, and run code \u2014 all from this extension.",
        "featuredFor": [
          "**/*.qmd"
        ],
        "steps": [
          {
            "id": "installQuarto",
            "title": "Install & verify Quarto",
            "description": "This extension needs the Quarto CLI on your `PATH`. Install it from [quarto.org](https://quarto.org/docs/get-started/), then verify the extension can find it.\n[Verify Installation](command:quarto.verifyInstallation)",
            "media": {
              "markdown": "media/walkthrough/install-quarto.md"
            },
            "completionEvents": [
              "onCommand:quarto.verifyInstallation"
            ]
          },
          {
            "id": "createDocument",
            "title": "Create your first document",
            "description": "Start writing right away with a blank `.qmd` document \u2014 no file needed on disk yet.\n[New Quarto Document](command:quarto.newDocument)",
            "media": {
              "markdown": "media/walkthrough/create-document.md"
            },
            "completionEvents": [
              "onCommand:quarto.newDocument"
            ]
          },
          {
            "id": "createProject",
            "title": "Create a project",
            "description": "Multi-file books, websites, and manuscripts start from a Quarto project. Pick a type, a folder, and a name \u2014 the extension scaffolds the rest and opens it.\n[Create Project](command:quarto.createProject)",
            "media": {
              "markdown": "media/walkthrough/create-project.md"
            },
            "completionEvents": [
              "onCommand:quarto.createProject"
            ]
          },
          {
            "id": "renderAndPreview",
            "title": "Render and preview",
            "description": "Render turns a `.qmd` (or a whole project) into its output format; preview opens a live-updating view alongside your editor.\n[Render](command:quarto.render)\n[Preview](command:quarto.preview)",
            "media": {
              "markdown": "media/walkthrough/render-preview.md"
            },
            "completionEvents": [
              "onCommand:quarto.preview"
            ]
          },
          {
            "id": "runCellAndExplore",
            "title": "Run a cell, then explore more",
            "description": "Run the cell under your cursor without leaving the editor.\n[Run Cell](command:quarto.runCell)\n\nKeep exploring: [Preview Math](command:quarto.previewMath) renders LaTeX live, and [Preview Diagram](command:quarto.previewDiagram) renders Mermaid diagrams live.",
            "media": {
              "markdown": "media/walkthrough/run-cell.md"
            },
            "completionEvents": [
              "onCommand:quarto.runCell"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "bundle": "node esbuild.js",
    "compile": "npm run check-types && npm run bundle",
    "watch": "node esbuild.js --watch",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "npm run compile && npm run compile-tests && node ./out/test/integration/runTest.js",
    "package": "npm run compile && vsce package",
    "vscode:prepublish": "npm run compile",
    "test:lsp": "npm run compile && npm run compile-tests && node ./out/test/lsp/runTest.js",
    "test:lsp:workspace": "QMD_LSP_DIAGMODE=workspace npm run test:lsp"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "katex": "^0.16.47",
    "mocha": "^10.8.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7"
  }
}
